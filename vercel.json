{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://api.web3forms.com; frame-src https://www.youtube.com https://www.youtube-nocookie.com https://calendar.google.com; object-src 'none'; base-uri 'self'; form-action 'self' https://api.web3forms.com; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "X-Permitted-Cross-Domain-Policies",
          "value": "none"
        }
      ]
    }
  ],
  "redirects": [
    { "source": "/new-jersey-comedian/", "destination": "/new-jersey-comedian", "permanent": true },
    { "source": "/corporate-comedian/", "destination": "/corporate-comedian", "permanent": true },
    { "source": "/party-comedian/", "destination": "/party-comedian", "permanent": true },
    { "source": "/fundraiser-comedian/", "destination": "/fundraiser-comedian", "permanent": true }
  ],
  "rewrites": [
    { "source": "/new-jersey-comedian", "destination": "/new-jersey-comedian/index.html" },
    { "source": "/corporate-comedian", "destination": "/corporate-comedian/index.html" },
    { "source": "/party-comedian", "destination": "/party-comedian/index.html" },
    { "source": "/fundraiser-comedian", "destination": "/fundraiser-comedian/index.html" },
    { "source": "/((?!admin).*)", "destination": "/index.html" }
  ]
}
